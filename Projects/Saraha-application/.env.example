# This is an example environment configuration file for the Saraha application.
# You can copy this file to a new file named .env and modify the values as needed for your local development environment.
################################

##  Configuration
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/saraha
JWT_SECRET=your_jwt_secret_here


## Nodemailer configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Saraha <your-email@gmail.com>"